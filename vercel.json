{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build",
        "cleanUrls": true,
        "includeFiles": ["src/images/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/backend/(.*)",
      "dest": "http://virsaa-api.us-east-2.elasticbeanstalk.com/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/build/index.html"
    }
  ]
}